# Yafa Voice Gateway - local development
# Copy to .env and fill in. NEVER commit .env.

# AWS region where Nova 2 Sonic is available (per YAFA AWS direction)
AWS_REGION=us-east-1

# Local AWS profile holding the YafaNovaSonicInvoke policy credentials.
# Leave unset to use the default credential chain (env vars / instance role).
# AWS_PROFILE=yafa-dev

# Model + voice overrides (defaults shown)
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
VOICE_ID=tiffany

# Gateway server binding - localhost ONLY for development.
PORT=3008
HOST=localhost

# Browser origins allowed to open a socket to this gateway.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private recommendation/RAG service used by Nova's read-only knowledge tool.
# Use the same 32+ character token configured on the recommendation service.
YAFA_RECOMMENDATION_SERVICE_URL=http://localhost:8000
YAFA_INTERNAL_SERVICE_TOKEN=
YAFA_KNOWLEDGE_TIMEOUT_MS=5000

# Public voice access is fail-closed in production. The storefront mints a
# short-lived signed token; the browser never receives this signing secret.
YAFA_VOICE_AUTH_REQUIRED=true
YAFA_VOICE_GATEWAY_SIGNING_SECRET=
YAFA_VOICE_GATEWAY_TOKEN_AUDIENCE=yafa-voice

# Cost and abuse controls. Ten minutes is a hard session cap in addition to
# the five-minute idle timeout.
YAFA_VOICE_MAX_SESSION_MS=600000
YAFA_VOICE_MAX_AUDIO_CHUNK_BYTES=65536
YAFA_VOICE_MAX_TEXT_CHARS=1000
YAFA_VOICE_MAX_CONNECTIONS_PER_MINUTE=10
YAFA_VOICE_MAX_CONNECTIONS_PER_USER=2
YAFA_VOICE_MAX_TEXT_EVENTS_PER_MINUTE=20
YAFA_VOICE_MAX_AUDIO_EVENTS_PER_MINUTE=720
