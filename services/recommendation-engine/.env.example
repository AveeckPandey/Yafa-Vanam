# No environment variables are required for V1.
# The authoritative development datasets are loaded from ./data on startup.
PORT=8000
YAFA_INTERNAL_SERVICE_TOKEN=
YAFA_BRAND_KNOWLEDGE_PATH=
SENTRY_DSN=
APP_ENV=development
ENVIRONMENT=development

# --- RAG / embeddings (Phase 1) ---
VECTOR_DATABASE_URL=
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSION=2048
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_RERANK_ENABLED=false

# --- Speech-to-text (Phase 3, optional) ---
# Transcription endpoint returns 503 unless WHISPER_ENABLED=true.
WHISPER_ENABLED=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
