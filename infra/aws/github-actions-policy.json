{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:758388043025:repository/yafa-api",
        "arn:aws:ecr:ap-south-1:758388043025:repository/yafa-web",
        "arn:aws:ecr:ap-south-1:758388043025:repository/yafa-advisor"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["autoscaling:StartInstanceRefresh", "autoscaling:DescribeInstanceRefreshes"],
      "Resource": "*"
    }
  ]
}
