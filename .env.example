# ------------------------------
# Web (storefront)
# ------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
COMMERCE_API_URL=http://localhost:4000
# Server-side base of the private YAFA RAG service. The browser never calls
# it directly; only the protected /api/yafa/* bridge can reach it.
YAFA_RAG_URL=
# Server-only public address and shared signing secret for short-lived Nova
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------
# AWS Cognito (storefront authentication)
# ------------------------------
# Which auth system the storefront runs is decided at RUNTIME by the server:
# /api/auth/capability reports "cognito" when all four COGNITO_* vars below are
# set, otherwise "native" (Go-managed accounts). Leave this build-time flag
# blank unless you want to force a value into the bundle for tooling purposes.
NEXT_PUBLIC_AUTH_PROVIDER=
# Server-only credentials for the custom sign-in/sign-up UI. The app client
# MUST be confidential (generate-secret) with USER_PASSWORD_AUTH +
# REFRESH_TOKEN_AUTH allowed; SecretHash is computed server-side and the
# secret never reaches the browser.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Which identity feeds the refresh-token SECRET_HASH for this pool's sign-in
# configuration: "username_claim" when users sign in with their username
# (including email-as-username pools), "sub" when the pool uses email/phone
# ALIASES (the permanent username differs from the sign-in identifier).
# Any other value disables Cognito mode at runtime.
COGNITO_REFRESH_USERNAME_SOURCE=username_claim
# Hosted-UI federation is not used; reserved for future Google/social login.
# Set true only after Google has been enabled as a Cognito identity provider.
NEXT_PUBLIC_COGNITO_GOOGLE_ENABLED=false

# ------------------------------
# Go API
# ------------------------------
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yafa_vanam?sslmode=disable
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379/0
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SENTRY_DSN=
YAFA_CATALOGUE_PATH=../../data/processed/Product.json
# AWS production queues. The low-stock queue is FIFO and is consumed by the
# inventory alert Lambda; leave both blank for local development.
ORDER_CONFIRMATION_QUEUE_URL=
INVENTORY_ALERT_QUEUE_URL=

YAFA_INTERNAL_SERVICE_TOKEN=
# Separate secret used by the trusted gateway to authorize private tenant IDs.
# Leave blank when only the public YAFA catalogue is enabled.
YAFA_TENANT_SIGNING_SECRET=

# ------------------------------
# Product knowledge / agentic RAG
# ------------------------------
# Dedicated PostgreSQL + pgvector for rag_documents/rag_chunks (production).
# Never exposed to Next.js, never the same database as DATABASE_URL above.
# Local dev can point this at docker-compose's rag-postgres instead:
#   postgresql://postgres:postgres@localhost:5433/yafa_rag?sslmode=disable
VECTOR_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# AWS production embedding provider.
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# Must equal the model's output dimension; validated at startup and against
# the stored pgvector column.
EMBEDDING_DIMENSION=1024
# Bedrock uses the EC2 instance profile in production; no model API key is needed.
BEDROCK_REGION=ap-south-1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Keep deterministic reranking off until measured evaluations justify it.
RAG_RERANK_ENABLED=false
# Bounded cache/concurrency controls. Change RAG_CACHE_NAMESPACE on each
# corpus release to invalidate local service caches.
RAG_CACHE_TTL_SECONDS=90
RAG_CACHE_MAX_ENTRIES=500
RAG_CACHE_NAMESPACE=local
RAG_MAX_CONCURRENT_EMBEDDINGS=8
RAG_QUERY_TIMEOUT_SECONDS=8
RAG_MIN_GROUNDING_SIMILARITY=0.62
RAG_MAX_CONTEXT_CHARS=6000
RAG_CIRCUIT_BREAKER_FAILURES=4
RAG_CIRCUIT_BREAKER_RESET_SECONDS=20
# Bedrock agentic response mode. Keep false locally; enable only after the
# account has Nova Lite access and the RAG evaluation suite passes.
YAFA_AGENTIC_RAG_ENABLED=false
YAFA_AGENT_MODEL=amazon.nova-lite-v1:0
# Leave blank to use deterministic retrieved-fact fallback only. If enabled,
# grant this exact model Bedrock InvokeModel access as well.
YAFA_AGENT_FALLBACK_MODEL=
# Optional second Bedrock region for regional failover.
YAFA_AGENT_FALLBACK_REGION=
YAFA_AGENT_MAX_TOOL_CALLS=2
YAFA_AGENT_TIMEOUT_SECONDS=12
YAFA_AGENT_MAX_OUTPUT_TOKENS=350

# ------------------------------
# Payments
# ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_ENABLED=false

# Local/demo only. Samples are visibly labeled and excluded from SEO.
# Keep false in production; real reviews come from the commerce API.
SHOW_SAMPLE_REVIEWS=false
