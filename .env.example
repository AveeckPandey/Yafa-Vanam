# ------------------------------
# Web (storefront)
# ------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
COMMERCE_API_URL=http://localhost:4000
# Server-side base of the private Python recommendation service. The browser
# never calls it directly; /api/advisor/* proxies through it. Leave blank in
# local development to get a clean 503 from the advisor routes.
ADVISOR_URL=
# Server-only public address and shared signing secret for short-lived Nova
# voice connection tokens. Never prefix the secret with NEXT_PUBLIC_.
YAFA_VOICE_GATEWAY_PUBLIC_URL=
YAFA_VOICE_GATEWAY_SIGNING_SECRET=
YAFA_VOICE_GATEWAY_TOKEN_AUDIENCE=yafa-voice
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------
# AWS Cognito (storefront authentication)
# ------------------------------
# Which auth system the storefront runs is decided at RUNTIME by the server:
# /api/auth/capability reports "cognito" when all four COGNITO_* vars below are
# set, otherwise "native" (Go-managed accounts). Leave this build-time flag
# blank unless you want to force a value into the bundle for tooling purposes.
NEXT_PUBLIC_AUTH_PROVIDER=
# Server-only credentials for the custom sign-in/sign-up UI. The app client
# MUST be confidential (generate-secret) with USER_PASSWORD_AUTH +
# REFRESH_TOKEN_AUTH allowed; SecretHash is computed server-side and the
# secret never reaches the browser.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Which identity feeds the refresh-token SECRET_HASH for this pool's sign-in
# configuration: "username_claim" when users sign in with their username
# (including email-as-username pools), "sub" when the pool uses email/phone
# ALIASES (the permanent username differs from the sign-in identifier).
# Any other value disables Cognito mode at runtime.
COGNITO_REFRESH_USERNAME_SOURCE=username_claim
# Hosted-UI federation is not used; reserved for future Google/social login.
# Set true only after Google has been enabled as a Cognito identity provider.
NEXT_PUBLIC_COGNITO_GOOGLE_ENABLED=false

# ------------------------------
# Go API
# ------------------------------
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yafa_vanam?sslmode=disable
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379/0
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SENTRY_DSN=
YAFA_CATALOGUE_PATH=../../data/processed/Product.json

# Private Yafa selfie storage and Go-to-Python authentication. Use distinct
# random values per environment; values below are intentionally blank.
YAFA_STORAGE_ENDPOINT=
# For AWS S3 on ECS, leave the endpoint and credentials blank; the task role
# supplies credentials through the AWS SDK default chain.
YAFA_STORAGE_REGION=ap-south-1
YAFA_STORAGE_BUCKET=
YAFA_STORAGE_ACCESS_KEY_ID=
YAFA_STORAGE_SECRET_ACCESS_KEY=
YAFA_ANALYZER_URL=http://localhost:8000
YAFA_INTERNAL_SERVICE_TOKEN=

# ------------------------------
# Product knowledge RAG (Phase 1)
# ------------------------------
# Dedicated PostgreSQL + pgvector for rag_documents/rag_chunks (production).
# Never exposed to Next.js, never the same database as DATABASE_URL above.
# Local dev can point this at docker-compose's rag-postgres instead:
#   postgresql://postgres:postgres@localhost:5433/yafa_rag?sslmode=disable
VECTOR_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Locked Phase 1 embedding provider (update spec section 2).
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# Must equal the model's output dimension; validated at startup, in every
# provider response, and against the stored VECTOR(2048) column.
EMBEDDING_DIMENSION=1024
# Bedrock uses the EC2 instance profile in production; no model API key is needed.
BEDROCK_REGION=ap-south-1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Phase 1 keeps reranking off until raw retrieval quality is evaluated.
RAG_RERANK_ENABLED=false

# ------------------------------
# Payments
# ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_ENABLED=false
