# Railway injects PORT. Do not set API_PORT in production unless required locally.
APP_ENV=production
ENVIRONMENT=production
PORT=4000
APP_URL=https://yafavanam.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=YAFA VANAM <hello@yafavanam.com>
CORS_ALLOWED_ORIGINS=https://yafavanam.com,https://www.yafavanam.com
DATABASE_URL=postgresql://<railway-managed-value>
REDIS_URL=redis://<railway-managed-value>
JWT_SECRET=<at-least-32-random-bytes>
YAFA_CATALOGUE_PATH=/app/data/processed/Product.json
MIGRATIONS_PATH=/app/db/migrations

# Razorpay server-only secrets. The key ID may be returned to the browser; never expose either secret.
RAZORPAY_CHECKOUT_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=<server-only>
RAZORPAY_WEBHOOK_SECRET=<server-only>
SENTRY_DSN=
RELEASE_VERSION=

# Private object storage and internal AI service authentication.
YAFA_STORAGE_ENDPOINT=https://<private-s3-or-r2-endpoint>
YAFA_STORAGE_REGION=auto
YAFA_STORAGE_BUCKET=yafa-private-selfies
YAFA_STORAGE_ACCESS_KEY_ID=<server-only>
YAFA_STORAGE_SECRET_ACCESS_KEY=<server-only>
YAFA_ANALYZER_URL=http://<railway-private-python-domain>:8000
YAFA_INTERNAL_SERVICE_TOKEN=<at-least-32-random-bytes>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yafavanam.com/api/auth/google/callback
